---
import Layout from '../layouts/Layout.astro';
---
<Layout title="AGAPE — Bijbel App">
  <style>
    .serif { font-family: 'Lora', Georgia, serif; }
    .card {
      transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1), border-color 0.3s, box-shadow 0.4s;
    }
    .card:hover {
      transform: translateY(-6px);
      border-color: #8C2F2F;
    }
    .btn-primary {
      background: #8C2F2F;
      transition: transform 0.25s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .btn-primary:hover { transform: translateY(-2px); }
    .phone {
      background: linear-gradient(160deg, #2a2d32, #121416);
      border-radius: 46px;
      padding: 10px;
      box-shadow: 0 40px 80px -20px rgba(0,0,0,.35);
    }
    .screen { border-radius: 36px; overflow: hidden; }
  </style>

  <!-- Navbar -->
  <header class="sticky top-4 z-40 max-w-5xl mx-auto px-4">
    <nav class="bg-[#FCFAF6]/90 backdrop-blur-md rounded-full px-5 py-3 flex items-center justify-between border border-[#72685A]/15 shadow-sm">
      <div class="flex items-center gap-2.5">
        <div class="w-9 h-9 rounded-2xl flex items-center justify-center text-white text-lg" style="background: linear-gradient(135deg, #8C2F2F, #B08D3E);">✝</div>
        <span class="font-bold text-lg tracking-tight text-[#2A241C]">AGAPE</span>
      </div>
      <div class="hidden md:flex items-center gap-7 text-sm font-medium text-[#72685A]">
        <a href="#features" class="hover:text-[#2A241C] transition">Features</a>
        <a href="#traditions" class="hover:text-[#2A241C] transition">Tradities</a>
        <a href="#download" class="hover:text-[#2A241C] transition">Download</a>
      </div>
      <a href="#download" class="btn-primary text-white px-5 py-2 rounded-full text-sm font-semibold">Download app</a>
    </nav>
  </header>

  <!-- Hero -->
  <section class="max-w-5xl mx-auto px-4 pt-16 pb-24 md:pt-24 md:pb-32">
    <div class="grid lg:grid-cols-12 gap-12 items-center">
      <div class="lg:col-span-7 text-center lg:text-left">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold tracking-wide uppercase mb-5 bg-[#8C2F2F]/10 text-[#8C2F2F]">
          <span class="w-1.5 h-1.5 rounded-full bg-[#8C2F2F]"></span>
          Bijbel • Gebed • Traditie
        </div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight leading-[1.05] text-[#2A241C]">
          Lees de Bijbel<br />
          <span class="serif italic font-medium text-[#8C2F2F]">met rust en diepgang.</span>
        </h1>
        <p class="mt-5 text-lg max-w-md mx-auto lg:mx-0 text-[#72685A]">
          AGAPE brengt Schrift, heiligen en traditie samen in een rustige, klassieke app. Voor wie dieper wil gaan.
        </p>
        <div class="mt-8 flex flex-col sm:flex-row gap-3 justify-center lg:justify-start">
          <a href="#download" class="btn-primary text-white px-7 py-3.5 rounded-full font-semibold text-center">Download voor Android</a>
          <a href="#features" class="px-7 py-3.5 rounded-full font-medium border border-[#72685A]/20 text-[#2A241C]">Bekijk features</a>
        </div>
      </div>

      <!-- Phone mockup -->
      <div class="lg:col-span-5 flex justify-center">
        <div class="phone w-[280px]">
          <div class="screen h-[540px] bg-[#F7F3EC] p-4 flex flex-col">
            <div class="flex justify-between text-xs font-medium mb-4 text-[#72685A]">
              <span>9:41</span>
              <span>100%</span>
            </div>
            <div class="text-xs font-bold tracking-wider uppercase mb-1 text-[#8C2F2F]">Vandaag</div>
            <div class="text-lg font-bold mb-4 text-[#2A241C]">Johannes 3:16</div>
            <div class="rounded-3xl p-5 text-white mb-4" style="background: linear-gradient(135deg, #8C2F2F, #B08D3E);">
              <p class="serif italic text-sm leading-relaxed">“Want zo lief heeft God de wereld gehad, dat Hij zijn enige Zoon gegeven heeft…”</p>
              <div class="mt-3 text-xs opacity-80">Johannes 3:16</div>
            </div>
            <div class="space-y-2.5 flex-1">
              <div class="p-3.5 rounded-2xl border border-[#72685A]/15 bg-white flex items-center gap-3">
                <div class="w-9 h-9 rounded-xl bg-[#8C2F2F]/10"></div>
                <div class="flex-1 space-y-1.5">
                  <div class="h-2.5 rounded-full w-3/4 bg-[#72685A]/15"></div>
                  <div class="h-2 rounded-full w-1/2 bg-[#72685A]/15"></div>
                </div>
              </div>
              <div class="p-3.5 rounded-2xl border border-[#72685A]/15 bg-white flex items-center gap-3">
                <div class="w-9 h-9 rounded-xl bg-[#8C2F2F]/10"></div>
                <div class="flex-1 space-y-1.5">
                  <div class="h-2.5 rounded-full w-2/3 bg-[#72685A]/15"></div>
                  <div class="h-2 rounded-full w-4/5 bg-[#72685A]/15"></div>
                </div>
              </div>
            </div>
            <div class="mt-auto pt-3 flex justify-around">
              <div class="w-8 h-1.5 rounded-full bg-[#8C2F2F]"></div>
              <div class="w-8 h-1.5 rounded-full bg-[#72685A]/20"></div>
              <div class="w-8 h-1.5 rounded-full bg-[#72685A]/20"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Quote -->
  <section class="max-w-5xl mx-auto px-4 py-8">
    <div class="card bg-[#FCFAF6] border border-[#72685A]/15 rounded-[28px] p-10 md:p-14 text-center">
      <blockquote class="serif text-2xl md:text-3xl italic leading-snug max-w-3xl mx-auto text-[#2A241C]">
        “God is liefde, en wie in de liefde blijft, blijft in God en God in hem.”
      </blockquote>
      <div class="mt-5 text-sm font-semibold tracking-wider uppercase text-[#8C2F2F]">1 Johannes 4:16</div>
    </div>
  </section>

  <!-- Features -->
  <section id="features" class="max-w-5xl mx-auto px-4 py-20">
    <div class="text-center max-w-xl mx-auto mb-12">
      <div class="text-xs font-semibold tracking-widest uppercase mb-3 text-[#8C2F2F]">Waarom AGAPE</div>
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#2A241C]">Rustig lezen. Dieper begrijpen.</h2>
    </div>

    <div class="grid md:grid-cols-12 gap-5">
      <div class="md:col-span-7 card bg-[#FCFAF6] border border-[#72685A]/15 rounded-[28px] p-8">
        <div class="w-11 h-11 rounded-2xl mb-5 flex items-center justify-center bg-[#8C2F2F]/10 text-[#8C2F2F]">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
        </div>
        <h3 class="text-xl font-bold mb-2 text-[#2A241C]">Schone Bijbellezer</h3>
        <p class="text-sm leading-relaxed text-[#72685A]">Grote, rustige typografie met kruisverwijzingen en aantekeningen. Geen afleiding.</p>
      </div>
      <div class="md:col-span-5 card bg-[#FCFAF6] border border-[#72685A]/15 rounded-[28px] p-8">
        <div class="w-11 h-11 rounded-2xl mb-5 flex items-center justify-center bg-[#8C2F2F]/10 text-[#8C2F2F]">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>
        </div>
        <h3 class="text-xl font-bold mb-2 text-[#2A241C]">Gebed & Heiligen</h3>
        <p class="text-sm leading-relaxed text-[#72685A]">Dagelijkse gebeden en wijsheid van de kerkvaders, dicht bij de tekst.</p>
      </div>
      <div class="md:col-span-5 card bg-[#FCFAF6] border border-[#72685A]/15 rounded-[28px] p-8">
        <div class="w-11 h-11 rounded-2xl mb-5 flex items-center justify-center bg-[#8C2F2F]/10 text-[#8C2F2F]">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
        </div>
        <h3 class="text-xl font-bold mb-2 text-[#2A241C]">Traditie in één</h3>
        <p class="text-sm leading-relaxed text-[#72685A]">Orthodox, katholiek en protestants — Schrift als gemeenschappelijke basis.</p>
      </div>
      <div class="md:col-span-7 card bg-[#FCFAF6] border border-[#72685A]/15 rounded-[28px] p-8">
        <div class="w-11 h-11 rounded-2xl mb-5 flex items-center justify-center bg-[#8C2F2F]/10 text-[#8C2F2F]">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
        </div>
        <h3 class="text-xl font-bold mb-2 text-[#2A241C]">Klassieke rust</h3>
        <p class="text-sm leading-relaxed text-[#72685A]">Warme kleuren, serif-citaten en een interface die ‘s avonds prettig leest.</p>
      </div>
    </div>
  </section>

  <!-- Download -->
  <section id="download" class="max-w-5xl mx-auto px-4 py-12">
    <div class="rounded-[32px] p-10 md:p-14 text-white relative overflow-hidden" style="background: linear-gradient(135deg, #8C2F2F, #2A241C);">
      <div class="max-w-xl">
        <div class="text-xs font-bold tracking-widest uppercase opacity-80 mb-3">Android</div>
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight mb-3">Begin vandaag met lezen.</h2>
        <p class="opacity-80 mb-6">Download AGAPE en ervaar Schrift met meer rust en diepgang.</p>
        <a href="#" class="inline-flex items-center gap-2 bg-white text-[#2A241C] font-semibold px-6 py-3 rounded-full">
          Download de app
        </a>
      </div>
    </div>
  </section>

  <footer class="max-w-5xl mx-auto px-4 py-10 text-sm flex flex-col sm:flex-row justify-between items-center gap-4 border-t border-[#72685A]/15 text-[#72685A]">
    <div class="font-semibold text-[#2A241C]">AGAPE</div>
    <div class="flex gap-6">
      <a href="#" class="hover:underline">Over</a>
      <a href="#" class="hover:underline">Privacy</a>
      <a href="https://github.com/gabriel360110l/AGAPE-website" class="hover:underline">GitHub</a>
    </div>
  </footer>
</Layout>
